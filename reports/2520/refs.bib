@article{schmid_semi-static_2025,
  title    = {Semi-{Static} {Template} {Matching} for {Sports} {Field} {Estimation}},
  volume   = {13},
  issn     = {2169-3536},
  url      = {https://ieeexplore.ieee.org/document/11132315/},
  doi      = {10.1109/ACCESS.2025.3601185},
  abstract = {Unmanned air vehicle imaging enables a new way of collecting data for sports events. Spatio-temporal tracking data is one of the most used data formats for sports analytics and is substantially more compressed than video data. To extract spatio-temporal tracking data in videos from unmanned air vehicles, we need to track the players, the ball and need to transform the tracked players from the video into the physical world. We propose a novel method to address the challenge of field registration from aerial imaging with fields of variable size, such as football fields. In addition, we extend field registration for a video setting based on unmanned air vehicle imaging. First, we detect keypoints for different fields like tennis, football, or ultimate frisbee in a stand-alone keypoint regression network. After that, we compile different methods of keypoint matching and homography estimation. For football fields, we introduce a novel way of estimating the sizes of the fields with a gradient-based alternating optimization approach, where we alternate between matching keypoints and updating field-size parameters constrained by a Frobenius norm. The algorithm enables data collection of football fields without physically measuring the field dimensions with a ground truth tool, as the length and width of the fields is variable. To efficiently evaluate our method, we compile a new dataset that contains images from 60 different video clips of field sports games. We empirically show that our algorithms return time-consistent transformations by analyzing error graphs over different videos.},
  urldate  = {2025-09-16},
  journal  = {IEEE Access},
  author   = {Schmid, Marc},
  year     = {2025},
  keywords = {alternating optimization, Autonomous aerial vehicles, Calibration, Cameras, Data mining, Estimation, Football, Games, image registration, Optimization, position detection, Sports, Training, Videos},
  pages    = {149965--149975},
